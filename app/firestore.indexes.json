{
  "//": "Composite indexes for the feed. Firestore builds single-field indexes on its own, so only the combinations a feed query actually asks for are here. Do NOT add __name__ to these: Firestore appends it implicitly, matching the direction of the last field, and declaring it is rejected as unnecessary. Every entry needs at least two real fields for the same reason.",
  "indexes": [
    {
      "//": "Newest first, whole feed. Category chips.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "cardCategory", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Top posts within a category.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "cardCategory", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "One collector's posts, newest first.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerHandle", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "One collector's best-loved posts.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerHandle", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Top across the whole feed, and the From the vaults top-up.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" }
      ]
    }
  ],
  "//2": "The default newest-first view (createdAt DESC) is deliberately NOT here. A single field is a single-field index, which Firestore builds on its own and rejects if declared — and one rejection aborts the whole deploy.",
  "//3": "These mirror what the project already has. They are here so a deploy stops offering to DELETE them: an empty list reads as 'this project should have none', and cards.addedAt is what orders every collection in the app.",
  "fieldOverrides": [
    {
      "collectionGroup": "cards",
      "fieldPath": "addedAt",
      "ttl": false,
      "indexes": [
        {
          "order": "ASCENDING",
          "queryScope": "COLLECTION"
        },
        {
          "order": "DESCENDING",
          "queryScope": "COLLECTION"
        },
        {
          "arrayConfig": "CONTAINS",
          "queryScope": "COLLECTION"
        },
        {
          "order": "DESCENDING",
          "queryScope": "COLLECTION_GROUP"
        }
      ]
    },
    {
      "collectionGroup": "cards",
      "fieldPath": "flagged",
      "ttl": false,
      "indexes": [
        {
          "order": "ASCENDING",
          "queryScope": "COLLECTION"
        },
        {
          "order": "DESCENDING",
          "queryScope": "COLLECTION"
        },
        {
          "arrayConfig": "CONTAINS",
          "queryScope": "COLLECTION"
        },
        {
          "order": "ASCENDING",
          "queryScope": "COLLECTION_GROUP"
        }
      ]
    }
  ]
}
