{
  "//": "Composite indexes for the feed. Firestore builds single-field indexes on its own, so only the combinations a feed query actually asks for are here. __name__ is listed explicitly and DESCENDING because the feed orders newest-first and uses the document reference as its cursor tiebreaker; an index whose __name__ runs the other way will not serve the query.",
  "indexes": [
    {
      "//": "Newest first, whole feed. Category chips.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "cardCategory", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Top posts within a category.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "cardCategory", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "One collector's posts, newest first.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerHandle", "order": "ASCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "One collector's best-loved posts.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "ownerHandle", "order": "ASCENDING" },
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Top across the whole feed, and the From the vaults top-up.",
      "collectionGroup": "feed",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "score", "order": "DESCENDING" },
        { "fieldPath": "createdAt", "order": "DESCENDING" },
        { "fieldPath": "__name__", "order": "DESCENDING" }
      ]
    }
  ],
  "//2": "The default newest-first view (createdAt DESC) is deliberately NOT here. One real field plus __name__ is a single-field index, which Firestore builds on its own and the CLI rejects outright as unnecessary — and one rejection aborts the whole deploy.",
  "fieldOverrides": []
}
