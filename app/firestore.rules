rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: is the requester a registered admin? ──
    function isAdmin() {
      return request.auth != null &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ── Admin registry ──
    // Only existing admins can read/write the admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ── User cards ──
    match /users/{uid}/cards/{cardId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── Collection group access for admin panel ──
    // Allows collectionGroup('cards') queries across all user subcollections
    match /{path=**}/cards/{cardId} {
      allow read, write: if isAdmin();
    }

    // ── User settings ──
    match /users/{uid}/settings/{settingId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // ── User profile docs ──
    // Users can read/write their own profile doc (reward credits, streaks, AI session, etc.)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();

      // ── Phase 2: Referral milestone reward ──────────────────────────────────
      // Allow an invitee to award card_credits and increment referral_count on
      // their referrer's document when they upload their 10th card.
      // Guards:
      //   1. Requester must be a different user (not self-referral)
      //   2. Invitee's own doc must have referral_source pointing to this uid
      //   3. Referral must not have been rewarded yet (prevents double-payment)
      //   4. Only card_credits and referral_count may be modified
      allow update: if request.auth != null
        && request.auth.uid != uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referral_source == uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.referral_rewarded != true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['card_credits', 'referral_count']);
    }

    // ── Public blog articles ──
    match /articles/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Push notifications (written by admin panel, read by the app) ──
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // ── Per-user credit gift notifications (subcollection) ──
    // Admin writes; user reads and marks as read.
    match /users/{uid}/notifications/{notifId} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if isAdmin();
    }

    // ── Global credit gifts (broadcast to all users) ──
    // Only admins write; any authenticated user can read and claim their own credits.
    match /global_gifts/{giftId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── User collections (saved card groups) ──
    match /users/{uid}/collections/{collectionId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Shared-collection links are served by the service-account API
    // (api/public-card.js), which can check what the owner actually shared.
    // The recursive `allow read: if true` that used to sit here exposed every
    // user's collections to anyone holding the Firebase web config, and that
    // config ships inside the browser bundle.

    // ── Handles: the uniqueness lock behind public profiles ──
    // World-readable so a profile URL resolves; only the API ever writes them.
    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    // ── Reactions ──
    // Counts are public. Every write goes through api/react.js with a verified
    // ID token, because rules cannot express "increment by exactly one, and
    // only alongside a matching per-user document".
    match /reactions/{targetKey} {
      allow read: if true;
      allow write: if false;
      match /by/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── The feed ──
    // World-readable: a feed entry only ever describes a card in a vault its
    // owner switched on for the public. Every write goes through api/feed.js
    // with a verified ID token, which reads the card and the owner's profile
    // settings itself. A client that could write here could post anything
    // under anyone's name, so no client can.
    match /feed/{entryId} {
      allow read: if true;
      allow write: if false;

      // Comments arrive in build step 5. Public to read, server-mediated to
      // write, so rate limits and the owner's delete are actually enforceable.
      match /comments/{commentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // ── Runtime config ──
    // `config/feed.enabled = false` empties the feed instantly, without a
    // deploy. Readable so the app can hide the tab; admin-only to change.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Abuse reports ──
    // A signed-in user can file one; only admins read or act on them.
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

  }
}
